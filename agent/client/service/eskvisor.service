[Unit]
Description=Eskvisor Virtualization Management Platform
After=network.target libvirtd.service
Wants=libvirtd.service

[Service]
Type=simple
# Запуск от root - ОПАСНО, но нужно для виртуализации
User=root
Group=root

# Команда запуска
ExecStart=/eskvisor/eskvisor_venv/bin/python -m uvicorn agent.client.main:app \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 1 \
    --timeout-keep-alive 30 \
    --log-level warning

# Автоматический перезапуск
Restart=always
RestartSec=10
StartLimitBurst=3

# Безопасность - ограничение прав
NoNewPrivileges=true
#PrivateTmp=true
#ProtectSystem=strict
#ReadWritePaths=/var/lib/libvirt/images /etc/libvirt

# Переменные окружения
Environment="PYTHONPATH=/opt/eskvisor/"
Environment="VIRTUAL_ENV=/eskvisor/eskvisor_venv/"
Environment="PATH=/opt/eskvisor/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# Resource limits (опционально)
CPUQuota=80%

# Логирование
StandardOutput=journal
StandardError=journal
SyslogIdentifier=eskvisor

[Install]
WantedBy=multi-user.target