# Для Ubuntu/Debian:
sudo apt update
sudo apt install -y qemu-kvm libvirt-daemon-system libvirt-clients bridge-utils virtinst

# Для CentOS/RHEL/ALT Linux:
sudo yum install -y qemu-kvm libvirt libvirt-client virt-install

# Для Fedora:
sudo dnf install -y qemu-kvm libvirt libvirt-client virt-install

sudo systemctl start libvirtd
sudo systemctl enable libvirtd

# Проверьте статус (должен быть "active (running)")
sudo systemctl status libvirtd


#_________________________________Создание пользователя eskvisor_______________________________________________
# Создать пользователя
sudo adduser eskvisor

# Дать права sudo (требует ввода пароля)
sudo usermod -aG sudo eskvisor  # Для Ubuntu/Debian
# ИЛИ
sudo usermod -aG wheel eskvisor  # Для CentOS/RHEL

sudo usermod -a -G libvirt eskvisor
sudo usermod -a -G kvm eskvisor
sudo usermod -aG qemu eskvisor
sudo usermod -aG disk eskvisor
sudo passwd eskvisor

newgrp libvirt
newgrp kvm
newgrp qemu
